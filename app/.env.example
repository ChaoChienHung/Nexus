# Optional: point Nexus at a separate private knowledge vault repository.
# Copy this file to `.env.local` (gitignored) and set your local vault path.
# The target directory should contain `wiki/` and `data/` (plus optional `raw/` and `outputs/`, same layout as `knowledge/`).
#
# NEXUS_KNOWLEDGE_DIR=../../Nexus-Vault

# Optional: connect a running Mentorion backend (Spaced Repetition & Quiz engine).
# When unset, Nexus runs in pure standalone mode. When set, Nexus probes Mentorion on startup
# and unlocks integrated review capabilities automatically when reachable.
#
# MENTORION_API_URL=http://localhost:8000
